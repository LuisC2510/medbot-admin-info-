# Puerto HTTP del servidor
PORT=3000

# Secreto para firmar JWT (OBLIGATORIO, mínimo 32 caracteres aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES_HEXADECIMALES

# Expiración del token JWT (ej: 30m, 15m)
JWT_EXPIRES_IN=30m

# Orígenes permitidos para CORS y Socket.IO (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Entorno (development | production)
NODE_ENV=development

# HTTPS local opcional
HTTPS_ENABLED=false
HTTPS_PORT=3443
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost.pem
